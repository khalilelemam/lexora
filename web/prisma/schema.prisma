// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ── Waitlist & Research Data Collection Models ─────────────

model WaitlistEntry {
  id               String        @id @default(cuid())
  fullName         String        @map("full_name")
  email            String        @unique
  phone            String?
  childAge         Int?          @map("child_age")
  userRole         String        @default("parent") @map("user_role") // 'parent' | 'teacher' | 'specialist' | 'other'
  notes            String?
  consentResearch  Boolean       @default(true) @map("consent_research")
  hasCompletedTest Boolean       @default(false) @map("has_completed_test")
  testAttempts     TestAttempt[]
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  @@map("waitlist_entries")
}

model TestAttempt {
  id                       String         @id
  waitlistEntryId          String?        @map("waitlist_entry_id")
  waitlistEntry            WaitlistEntry? @relation(fields: [waitlistEntryId], references: [id], onDelete: SetNull)
  testType                 String         @default("WEBCAM") @map("test_type")
  participantAge           Int            @default(8) @map("participant_age")
  label                    String?        @default("Research Participant")
  readingLanguage          String         @default("ar") @map("reading_language")
  calibrationMode          String         @default("GRID") @map("calibration_mode")
  calibrationQuality       String         @default("good") @map("calibration_quality")
  averageError             Float?         @map("average_error")
  jsonFilePath             String?        @map("json_file_path")
  totalGazePoints          Int            @default(0) @map("total_gaze_points")
  syllablesPointCount      Int            @default(0) @map("syllables_point_count")
  pseudoWordsPointCount    Int            @default(0) @map("pseudo_words_point_count")
  meaningfulTextPointCount Int            @default(0) @map("meaningful_text_point_count")
  screenResolution         String?        @map("screen_resolution")
  userAgent                String?        @map("user_agent")
  createdAt                DateTime       @default(now()) @map("created_at")
  updatedAt                DateTime       @updatedAt @map("updated_at")

  @@map("test_attempts")
}

// ── Better Auth models (SQLite compatible) ─────────────────

model User {
  id              String    @id
  name            String?
  email           String    @unique
  emailVerified   Boolean   @default(false) @map("email_verified")
  image           String?
  role            String    @default("USER")
  termsAcceptedAt DateTime? @map("terms_accepted_at")
  rawDataConsent  Boolean   @default(false) @map("raw_data_consent")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  sessions        Session[]
  accounts        Account[]

  @@map("users")
}

model Session {
  id        String   @id
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "sessions_user_id_idx")
  @@map("sessions")
}

model Account {
  id                    String    @id
  userId                String    @map("user_id")
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  idToken               String?   @map("id_token")
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId], map: "accounts_provider_account_unique")
  @@index([userId], map: "accounts_user_id_idx")
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier], map: "verifications_identifier_idx")
  @@map("verifications")
}
