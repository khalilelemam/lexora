# ──────────────────────────────────────────────────────────────
# Lexora Waitlist — Environment Variables
# Copy this file to .env.local for local development.
# ──────────────────────────────────────────────────────────────

# ── Database & Storage ───────────────────────────────────────
# SQLite database URL.
# Local development default: file:./dev.db
# On Vercel / serverless: defaults automatically to file:/tmp/dev.db
DATABASE_URL="file:./dev.db"

# Optional custom directory to store raw eye-tracking test session JSONs.
# Local default: data/tests
# On Vercel: /tmp/data/tests
# DATA_DIR="data/tests"

# ── Admin & Security ──────────────────────────────────────────
# Secret key required to access administrative waitlist data and CSV exports:
#   - GET /api/waitlist?secret=<ADMIN_SECRET>
#   - GET /api/waitlist/export?secret=<ADMIN_SECRET>
# Defaults to "lexora-waitlist-secret" if not set. Change this in production!
ADMIN_SECRET="lexora-waitlist-secret"

# ── MediaPipe / Webcam Eye Tracking (Optional Defaults) ────────
# Version of the @mediapipe/tasks-vision package CDN asset.
# Default: 0.10.32
NEXT_PUBLIC_MEDIAPIPE_VERSION="0.10.32"

# URL of the MediaPipe FaceLandmarker model file (.task).
# Default: Google Cloud Storage hosted model
NEXT_PUBLIC_MEDIAPIPE_MODEL_URL="https://storage.googleapis.com/mediapipe-models/face_landmarker/face_landmarker/float16/1/face_landmarker.task"

# Ideal webcam capture dimensions (pixels).
NEXT_PUBLIC_WEBCAM_WIDTH="1280"
NEXT_PUBLIC_WEBCAM_HEIGHT="720"

# Calibration & Fixation thresholds
NEXT_PUBLIC_CALIBRATION_COUNTDOWN_SECONDS="5"
NEXT_PUBLIC_STABLE_FIXATION_MS="300"
NEXT_PUBLIC_STABLE_VELOCITY_THRESHOLD="0.55"
NEXT_PUBLIC_CAPTURE_COOLDOWN_MS="45"
NEXT_PUBLIC_VALIDATION_SETTLE_MS="450"
NEXT_PUBLIC_VALIDATION_HOLD_MS="1200"
NEXT_PUBLIC_VALIDATION_THRESHOLD="0.12"
NEXT_PUBLIC_CALIBRATION_THRESHOLD_GOOD="0.04"
NEXT_PUBLIC_CALIBRATION_THRESHOLD_ACCEPTABLE="0.08"
NEXT_PUBLIC_MIN_GAZE_POINTS="20"
NEXT_PUBLIC_WEBCAM_EMA_ALPHA="0.3"

# ── Debug Flags (Optional) ────────────────────────────────────
NEXT_PUBLIC_DEBUG_GAZE_OVERLAY="false"
NEXT_PUBLIC_DEBUG_CALIBRATION_LOG="false"
NEXT_PUBLIC_GAZE_SNAPPING_MODE="raw"
